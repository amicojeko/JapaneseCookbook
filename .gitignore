# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader
/static/image-metadata.json
# image-srcset.json + le varianti responsive -NNNw .jpg/.webp sono ora
# committate. Vengono rigenerate incrementalmente da scripts/optimize-images.js
# (solo i master il cui MD5 è cambiato vengono ri-encodati) tramite il
# pre-commit hook in .husky/pre-commit — la CI non rifa il lavoro, consuma
# direttamente i file dal repo.

# Misc
.DS_Store
# Alternate data stream "Mark of the Web" che Windows appiccica ai file
# scaricati. Sono sempre vuoti e su Windows non sono nemmeno checkoutabili
# (i due punti non sono un carattere valido nei nomi file).
*:Zone.Identifier

# Credenziali bot Telegram (il .sample va invece committato)
.paginegiappe-telegram-token

.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

tmp

# Claude Code (config locale, worktree temporanei, ecc.)
# Ignora tutto dentro .claude/ TRANNE le skill di progetto, che vanno committate.
.claude/*
!.claude/skills/
